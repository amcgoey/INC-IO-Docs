# ==============================================================================
# INC-IO Docs - Environment Configuration Template
# Copy this file to .env (do NOT commit .env to source control)
# ==============================================================================

# Application Manifest Configuration
APP_MANIFEST_PATH=./assets/manifest.json

# Local Server Configuration
PORT=8080
HOST=0.0.0.0

# Google Workspace / OAuth2 Credentials (for local E2E testing against real Drive API)
# Obtain these from your Google Cloud Console OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-user-oauth-refresh-token

# Optional: Specific target File ID in Google Drive for manual / synthetic testing
TEST_DRIVE_FILE_ID=

# Optional: Set to 'true' in development / local testing to bypass Google JWT verification
SKIP_JWT_VERIFICATION=false
