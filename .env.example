# ==============================================================================
# INC-IO Docs - Environment Configuration Template
# Copy this file to .env (do NOT commit .env to source control)
# ==============================================================================

# Application Manifest Configuration
APP_MANIFEST_PATH=./assets/manifest.json

# Local Server Configuration
PORT=8080
HOST=0.0.0.0

# Google Workspace / OAuth2 Credentials (for local live testing in test/live/ against real Drive / Sheets APIs)
# Obtain OAuth refresh credentials from your Google Cloud Console OAuth 2.0 Client IDs,
# provide a short-lived GOOGLE_ACCESS_TOKEN, or empty/remove the placeholder OAuth lines below
# to fall back to ambient Google Application Default Credentials (ADC).
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-user-oauth-refresh-token
GOOGLE_ACCESS_TOKEN=

# Optional: Specific target File ID in Google Drive for manual / synthetic testing
TEST_DRIVE_FILE_ID=

# Optional: Scratch Drive folder ID for opt-in copy-and-trash live Google Sheets and DocumentLog verification (test/live/)
# When set, live suites copy `INC Document Log Template` into this scratch Drive folder and trash the copy in afterAll.
# Offline suites (`npm test`, `npm run test:all`) exclude test/live/ so local .env credentials remain inert.
# Run live suites sequentially via:
#   npm run test:live           (all 5 live suites)
#   npm run test:live:sheets    (or :arch, :ffe, :cover-sheet, :space for a scoped suite)
DOCUMENT_LOG_TEST_FOLDER_ID=

# Optional: Set to 'true' in development / local testing to bypass Google JWT verification
SKIP_JWT_VERIFICATION=false

# Optional: Positive integer byte limit overriding AppConfiguration.maxInMemoryFileBytes (default 209715200 bytes / 200 MB)
MAX_IN_MEMORY_FILE_BYTES=

# Confidential Google Drive file ID for Manifest configuration.templates.submittalCoverSheet
# Leave empty in source control; set in local .env or GitHub Environment secret SUBMITTAL_COVER_SHEET_TEMPLATE_ID
SUBMITTAL_COVER_SHEET_TEMPLATE_ID=
