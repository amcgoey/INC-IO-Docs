{
  "oauthScopes": [
    "https://www.googleapis.com/auth/drive",
    "https://www.googleapis.com/auth/drive.addons.metadata.readonly",
    "https://www.googleapis.com/auth/gmail.addons.execute",
    "https://www.googleapis.com/auth/gmail.readonly",
    "https://www.googleapis.com/auth/userinfo.email"
  ],
  "addOns": {
    "common": {
      "name": "{{ADDON_NAME}}",
      "logoUrl": "{{LOGO_URL}}",
      "homepageTrigger": {
        "runFunction": "{{BASE_URL}}/workspace/homepage"
      }
    },
    "drive": {
      "homepageTrigger": {
        "runFunction": "{{BASE_URL}}/workspace/homepage"
      },
      "onItemsSelectedTrigger": {
        "runFunction": "{{BASE_URL}}/workspace/drive-items-selected"
      }
    },
    "gmail": {
      "contextualTriggers": [
        {
          "unconditional": {},
          "onTriggerFunction": "{{BASE_URL}}/workspace/gmail-contextual"
        }
      ]
    }
  }
}
