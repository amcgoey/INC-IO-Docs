  "documentWorkflowConfig": {
    "workflows": [
      {
        "name": "SubmitTestWorkflow",
        "activitySequence": [
          {
            "type": "MOVE_FILE",
            "payload": {
              "folderName": "Unfiled"
            }
          }
        ]
      }
    ]
  },
  "storageContextConfig": {
    "rootFolder": "TestDocuments"
  }
}
