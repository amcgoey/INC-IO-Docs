{
  "key": "submittal-ffe",
  "name": "Submittal FF&E",
  "documentSchema": {
    "fields": [
      {
        "key": "status",
        "name": "Status",
        "type": "string",
        "required": true,
        "defaultValue": "Open",
        "options": {
          "source": "statuses",
          "key": "key"
        }
      },
      {
        "key": "specTag",
        "name": "Spec Tag",
        "type": "string",
        "required": true,
        "minLength": 1,
        "pattern": "^.*\\S+.*$",
        "options": {
          "source": "specs",
          "key": "key",
          "allowUserInput": true
        }
      },
      {
        "key": "relatedTag",
        "name": "Related Tag",
        "type": "string",
        "required": false,
        "options": {
          "source": "specs",
          "key": "key",
          "allowUserInput": true
        }
      },
      {
        "key": "revision",
        "name": "Revision",
        "type": "string",
        "required": true,
        "minLength": 1,
        "pattern": "^.*\\S+.*$"
      },
      {
        "key": "specTitle",
        "name": "Spec Title",
        "type": "string",
        "required": true,
        "minLength": 1,
        "pattern": "^.*\\S+.*$",
        "linkedField": {
          "sourceField": "specTag",
          "sourceProperty": "name"
        }
      },
      {
        "key": "vendor",
        "name": "Vendor",
        "type": "string",
        "required": true,
        "minLength": 1,
        "pattern": "^.*\\S+.*$",
        "options": {
          "source": "vendors",
          "key": "key",
          "name": "name",
          "allowUserInput": true
        }
      },
      {
        "key": "date",
        "name": "Date",
        "type": "string",
        "description": "Date in yyMMdd format",
        "required": true
      },
      {
        "key": "contact",
        "name": "Contact",
        "type": "string",
        "required": true,
        "minLength": 1,
        "pattern": "^.*\\S+.*$",
        "options": {
          "source": "contacts",
          "key": "key",
          "name": "name",
          "allowUserInput": true
        }
      },
      {
        "key": "action",
        "name": "Action",
        "type": "string",
        "required": true,
        "defaultValue": "REC",
        "options": {
          "source": "actions",
          "key": "key",
          "name": "name"
        }
      },
      {
        "key": "notes",
        "name": "Notes",
        "type": "string",
        "required": false
      }
    ],
    "options": {
      "statuses": [
        { "key": "Open" },
        { "key": "Closed" },
        { "key": "Waiting" },
        { "key": "Manager" },
        { "key": "Billed" }
      ],
      "actions": [
        { "key": "REC", "name": "Received", "suffix": "", "order": "1" },
        { "key": "REF", "name": "Referred", "suffix": "_REF", "order": "2" },
        { "key": "NR", "name": "Not Reviewed", "suffix": "_NR", "order": "3" },
        { "key": "REJ", "name": "Rejected", "suffix": "_REJ", "order": "4" },
        { "key": "RR", "name": "Revise & Resubmit", "suffix": "_RR", "order": "5" },
        { "key": "NOC", "name": "No Objection as Corrected", "suffix": "_NOC", "order": "6" },
        { "key": "NET", "name": "No Exceptions Taken", "suffix": "_NET", "order": "7" }
      ],
      "contacts": [
        { "key": "INC", "name": "INC Architecture & Design", "type": "INC" },
        { "key": "BW", "name": "Benjamin West", "type": "Procurement" },
        { "key": "VLD", "name": "Ventresca Lighting Design", "type": "Lighting" },
        { "key": "IHG", "name": "IHG Hotels & Resorts", "type": "Brand" }
      ],
      "vendors": [
        { "key": "BM", "name": "Berman Falk", "type": "Casegoods" },
        { "key": "AL", "name": "Ashley Lighting", "type": "Lighting" },
        { "key": "Carn", "name": "Carnegie", "type": "Fabric" },
        { "key": "Delta", "name": "Delta", "type": "Fabric" },
        { "key": "FDT", "name": "Fil Doux Textiles", "type": "Fabric" },
        { "key": "LA", "name": "Light Annex", "type": "Lighting" },
        { "key": "MH", "name": "Mohawk", "type": "Fabric" }
      ],
      "specs": [
        { "key": "AC102", "name": "HOOK" },
        { "key": "CG104", "name": "BED - KING" },
        { "key": "CG126", "name": "BED - DOUBLE QUEEN" },
        { "key": "CG138", "name": "CREDENZA" },
        { "key": "CG138M", "name": "CREDENZA - MIRRORED" },
        { "key": "CP112", "name": "CARPET - CORRIDOR" },
        { "key": "CP119", "name": "CARPET" },
        { "key": "FB127", "name": "FABRIC - LEATHER" },
        { "key": "FB132", "name": "FABRIC - WOVEN" },
        { "key": "FB132B", "name": "FABRIC - WOVEN" },
        { "key": "FB135", "name": "FABRIC - LEATHER" },
        { "key": "FB141", "name": "FABRIC - WOVEN" },
        { "key": "FB149", "name": "FABRIC - LEATHER" },
        { "key": "FB156", "name": "FABRIC - LEATHER" },
        { "key": "FB158", "name": "FABRIC - WOVEN" },
        { "key": "FB174", "name": "FABRIC - BLACKOUT" },
        { "key": "FB198", "name": "FABRIC - SHEER" },
        { "key": "LT108", "name": "SCONCE" },
        { "key": "LT125", "name": "TABLE LAMP" },
        { "key": "LT134", "name": "SCONCE" },
        { "key": "LT136", "name": "SCONCE - HEADBOARD" },
        { "key": "LT150", "name": "PENDANT" },
        { "key": "LT159A", "name": "SCONCE - CORRIDOR" },
        { "key": "LT159B", "name": "SCONCE - CORRIDOR" },
        { "key": "LT162", "name": "PENDANT" },
        { "key": "MI132", "name": "MIRROR - VANITY" },
        { "key": "MI166", "name": "MIRROR - FULL LENGTH" },
        { "key": "SE145A", "name": "CHAISE" },
        { "key": "SE145B", "name": "CHAISE - OPEN BACK" },
        { "key": "SE145C", "name": "CHAISE - HYBRID" },
        { "key": "SE167", "name": "CHAISE - SMALL" },
        { "key": "TA139", "name": "TABLE - WORK" },
        { "key": "TA139B", "name": "TABLE - WORK - SMALL" }
      ]
    },
    "calculatedFields": [
      {
        "name": "Link",
        "key": "link",
        "template": "-"
      },
      {
        "name": "File Name",
        "key": "fileName",
        "template": "{{specTag.key}}-{{revision}} {{vendor.name}} - {{date}} {{contact.key}}{{action.suffix}}"
      },
      {
        "name": "Name",
        "key": "name",
        "template": "{{specTag.key}}-{{revision}} {{vendor.name}}"
      },
      {
        "name": "Number",
        "key": "number",
        "template": "{{specTag.key}}-{{revision}}"
      },
      {
        "name": "Contact Chain",
        "key": "contactChain",
        "template": "{{contact.key}}"
      }
    ],
    "identity": {
      "idGroup": "{{specTag.key}}",
      "idDocument": "{{specTag.key}}-{{revision}}",
      "id": "{{specTag.key}}-{{revision}}-{{date}}-{{action.order}}"
    }
  },
  "storageContextConfig": {
    "basePath": "3 FFE"
  },
  "documentUiSchema": {
    "layout": [
      "status",
      "specTag",
      "relatedTag",
      "revision",
      "specTitle",
      "vendor",
      "date",
      "contact",
      "action",
      "notes"
    ],
    "fields": {
      "status": {
        "widget": "selectionInput",
        "label": "Status"
      },
      "specTag": {
        "widget": "textInput",
        "label": "Spec Tag"
      },
      "relatedTag": {
        "widget": "textInput",
        "label": "Related Tag"
      },
      "revision": {
        "widget": "textInput",
        "label": "Revision"
      },
      "specTitle": {
        "widget": "textInput",
        "label": "Spec Title"
      },
      "vendor": {
        "widget": "textInput",
        "label": "Vendor"
      },
      "date": {
        "widget": "textInput",
        "label": "Date"
      },
      "contact": {
        "widget": "textInput",
        "label": "Contact"
      },
      "action": {
        "widget": "selectionInput",
        "label": "Action"
      },
      "notes": {
        "widget": "textInput",
        "label": "Notes"
      }
    },
    "events": {
      "onSubmit": {
        "catchAllWorkflow": "FileSubmittalFFE"
      }
    }
  },
  "documentWorkflowConfig": {
    "workflows": [
      {
        "name": "FileSubmittalFFE",
        "activitySequence": [
          {
            "type": "MOVE_FILE",
            "payload": {
              "rootStorageId": "{{Document.space.abstractStorageId}}",
              "parentPath": "{{StorageContext.basePath}}",
              "folderName": "05 Submittals"
            }
          }
        ]
      }
    ]
  }
}
