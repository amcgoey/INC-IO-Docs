{
  "key": "submittal-ffe",
  "name": "Submittal FF&E",
  "documentSchema": {
    "fields": [
      {
        "key": "status",
        "name": "Status",
        "type": "string",
        "required": true,
        "defaultValue": "Open",
        "options": {
          "source": "statuses",
          "key": "key"
        }
      },
      {
        "key": "specTag",
        "name": "Spec Tag",
        "type": "string",
        "required": true,
        "minLength": 1,
        "pattern": "^.*\\S+.*$",
        "options": {
          "source": "specs",
          "key": "key",
          "allowUserInput": true
        }
      },
      {
        "key": "relatedTag",
        "name": "Related Tag",
        "type": "string",
        "required": false,
        "options": {
          "source": "specs",
          "key": "key",
          "allowUserInput": true
        }
      },
      {
        "key": "revision",
        "name": "Revision",
        "type": "string",
        "required": true,
        "minLength": 1,
        "pattern": "^.*\\S+.*$"
      },
      {
        "key": "specTitle",
        "name": "Spec Title",
        "type": "string",
        "required": true,
        "minLength": 1,
        "pattern": "^.*\\S+.*$",
        "linkedField": {
          "sourceField": "specTag",
          "sourceProperty": "name"
        }
      },
      {
        "key": "vendor",
        "name": "Vendor",
        "type": "string",
        "required": true,
        "minLength": 1,
        "pattern": "^.*\\S+.*$",
        "options": {
          "source": "vendors",
          "key": "key",
          "name": "name",
          "allowUserInput": true
        }
      },
      {
        "key": "date",
        "name": "Date",
        "type": "string",
        "description": "Date in yyMMdd format",
        "required": true
      },
      {
        "key": "contact",
        "name": "Contact",
        "type": "string",
        "required": true,
        "minLength": 1,
        "pattern": "^.*\\S+.*$",
        "options": {
          "source": "contacts",
          "key": "key",
          "name": "name",
          "allowUserInput": true
        }
      },
      {
        "key": "action",
        "name": "Action",
        "type": "string",
        "required": true,
        "defaultValue": "REC",
        "options": {
          "source": "actions",
          "key": "key",
          "name": "name"
        }
      },
      {
        "key": "notes",
        "name": "Notes",
        "type": "string",
        "required": false
      }
    ],
    "options": {
      "specs": [
        { "key": "AC102", "name": "HOOK" },
        { "key": "CG104", "name": "BED - KING" },
        { "key": "CG126", "name": "BED - DOUBLE QUEEN" },
        { "key": "CG138", "name": "CREDENZA" },
        { "key": "CG138M", "name": "CREDENZA - MIRRORED" },
        { "key": "CP112", "name": "CARPET - CORRIDOR" },
        { "key": "CP119", "name": "CARPET" },
        { "key": "FB127", "name": "FABRIC - LEATHER" },
        { "key": "FB132", "name": "FABRIC - WOVEN" },
        { "key": "FB132B", "name": "FABRIC - WOVEN" },
        { "key": "FB135", "name": "FABRIC - LEATHER" },
        { "key": "FB141", "name": "FABRIC - WOVEN" },
        { "key": "FB149", "name": "FABRIC - LEATHER" },
        { "key": "FB156", "name": "FABRIC - LEATHER" },
        { "key": "FB158", "name": "FABRIC - WOVEN" },
        { "key": "FB174", "name": "FABRIC - BLACKOUT" },
        { "key": "FB198", "name": "FABRIC - SHEER" },
        { "key": "LT108", "name": "SCONCE" },
        { "key": "LT125", "name": "TABLE LAMP" },
        { "key": "LT134", "name": "SCONCE" },
        { "key": "LT136", "name": "SCONCE - HEADBOARD" },
        { "key": "LT150", "name": "PENDANT" },
        { "key": "LT159A", "name": "SCONCE - CORRIDOR" },
        { "key": "LT159B", "name": "SCONCE - CORRIDOR" },
        { "key": "LT162", "name": "PENDANT" },
        { "key": "MI132", "name": "MIRROR - VANITY" },
        { "key": "MI166", "name": "MIRROR - FULL LENGTH" },
        { "key": "SE145A", "name": "CHAISE" },
        { "key": "SE145B", "name": "CHAISE - OPEN BACK" },
        { "key": "SE145C", "name": "CHAISE - HYBRID" },
        { "key": "SE167", "name": "CHAISE - SMALL" },
        { "key": "TA139", "name": "TABLE - WORK" },
        { "key": "TA139B", "name": "TABLE - WORK - SMALL" }
      ]
    },
    "optionSources": {
      "statuses": {
        "provider": "document_log",
        "properties": ["key"]
      },
      "actions": {
        "provider": "document_log",
        "properties": ["key", "name", "suffix", "order"]
      },
      "contacts": {
        "provider": "document_log",
        "properties": ["key", "name"]
      },
      "vendors": {
        "provider": "document_log",
        "properties": ["key", "name"]
      }
    },
    "calculatedFields": [
      {
        "name": "Link",
        "key": "link",
        "template": "-"
      },
      {
        "name": "File Name",
        "key": "fileName",
        "template": "{{specTag.key}}-{{revision}} {{vendor.name}} - {{date}} {{contact.key}}{{action.suffix}}"
      },
      {
        "name": "Name",
        "key": "name",
        "template": "{{specTag.key}}-{{revision}} {{vendor.name}}"
      },
      {
        "name": "Number",
        "key": "number",
        "template": "{{specTag.key}}-{{revision}}"
      },
      {
        "name": "Contact Chain",
        "key": "contactChain",
        "template": "{{contact.key}}"
      }
    ],
    "identity": {
      "idGroup": "{{specTag.key}}",
      "idDocument": "{{specTag.key}}-{{revision}}",
      "id": "{{specTag.key}}-{{revision}}-{{date}}-{{action.order}}"
    }
  },
  "storageContextConfig": {
    "basePath": "3 FFE"
  },
  "documentUiSchema": {
    "layout": [
      "status",
      "specTag",
      "relatedTag",
      "revision",
      "specTitle",
      "vendor",
      "date",
      "contact",
      "action",
      "notes"
    ],
    "fields": {
      "status": {
        "widget": "selectionInput",
        "label": "Status"
      },
      "specTag": {
        "widget": "textInput",
        "label": "Spec Tag",
        "onChange": true
      },
      "relatedTag": {
        "widget": "textInput",
        "label": "Related Tag"
      },
      "revision": {
        "widget": "textInput",
        "label": "Revision"
      },
      "specTitle": {
        "widget": "textInput",
        "label": "Spec Title"
      },
      "vendor": {
        "widget": "textInput",
        "label": "Vendor"
      },
      "date": {
        "widget": "textInput",
        "label": "Date"
      },
      "contact": {
        "widget": "textInput",
        "label": "Contact"
      },
      "action": {
        "widget": "selectionInput",
        "label": "Action"
      },
      "notes": {
        "widget": "textInput",
        "label": "Notes"
      }
    },
    "events": {
      "onSubmit": {
        "catchAllWorkflow": "FileSubmittalFFE"
      }
    }
  },
  "documentWorkflowConfig": {
    "workflows": [
      {
        "name": "FileSubmittalFFE",
        "activitySequence": [
          {
            "type": "MOVE_FILE",
            "payload": {
              "rootStorageId": "{{Document.space.abstractStorageId}}",
              "parentPath": "{{StorageContext.basePath}}",
              "folderName": "05 Submittals"
            }
          },
          {
            "type": "WRITE_LOG",
            "payload": {}
          }
        ]
      }
    ]
  },
  "documentLogSchema": {
    "provider": "google_sheets",
    "target": {
      "sheetName": "Submittal FF&E",
      "rangeName": "Log_Submittal_FFE",
      "extentMarker": "<--->",
      "groupDividerMarker": "---"
    },
    "grouping": {
      "groupBy": "idGroup",
      "sortBy": "id",
      "groupSortOrder": "asc",
      "rowSortOrder": "asc",
      "duplicatePolicy": "insert"
    },
    "columns": {
      "Status": { "template": "{{status.key}}" },
      "Spec Tag": { "template": "{{specTag.key}}" },
      "Related Tag": { "template": "{{relatedTag.key}}" },
      "Revision": { "template": "{{revision}}" },
      "Spec Title": { "template": "{{specTitle}}", "readOnly": true },
      "Vendor": { "template": "{{vendor.name}}" },
      "Date": { "template": "{{date}}" },
      "Contact": { "template": "{{contact.key}}" },
      "Action": { "template": "{{action.name}}" },
      "Notes": { "template": "{{notes}}" },
      "Calc Link": { "source": "fileLink", "label": "Link" }
    },
    "historyDisplay": {
      "topLabel": "Rev {{revision}} • {{specTag.key}} • {{status.key}}",
      "text": "<b>{{action.name}}</b> {{date}} ({{contact.key}})",
      "bottomLabel": "{{specTitle}} — {{vendor.name}}"
    },
    "optionBindings": {
      "statuses": {
        "sheetName": "_Config Submittal FF&E",
        "rangeName": "Options_Submittal_FFE_Statuses",
        "validationRangeName": "Validation_Submittal_FFE_Statuses",
        "endMarker": "---",
        "columns": {
          "Status": "key"
        }
      },
      "actions": {
        "sheetName": "_Config Submittal FF&E",
        "rangeName": "Options_Submittal_FFE_Actions",
        "endMarker": "---",
        "columns": {
          "Action": "key",
          "Name": "name",
          "Suffix": "suffix",
          "Order": "order"
        }
      },
      "contacts": {
        "sheetName": "_Config Submittal FF&E",
        "rangeName": "Options_Submittal_FFE_Contacts",
        "validationRangeName": "Validation_Submittal_FFE_Contacts",
        "endMarker": "---",
        "columns": {
          "Contact": "key",
          "Name": "name"
        }
      },
      "vendors": {
        "sheetName": "_Config Submittal FF&E",
        "rangeName": "Options_Submittal_FFE_Vendors",
        "validationRangeName": "Validation_Submittal_FFE_Vendors",
        "endMarker": "---",
        "columns": {
          "Vendor": "key",
          "Name": "name"
        }
      }
    }
  },
  "documentFormSchema": {
    "fields": {
      "Submittal No": {
        "template": "{{specTag.key}}-{{revision}}"
      },
      "Submittal Response": {
        "template": "{{action.name}}",
        "valueMap": {
          "RR": "Revise and Resubmit"
        }
      },
      "Date": {
        "template": "{{date}}",
        "format": "date"
      }
    }
  },
  "documentParseSchema": {
    "extractors": [
      {
        "source": "gmail",
        "fields": {
          "action": [
            {
              "when": {
                "!=": [
                  { "var": "email.fromDomain" },
                  "inc.nyc"
                ]
              },
              "set": "REC"
            }
          ],
          "date": {
            "from": "email.date"
          },
          "contact": [
            {
              "when": {
                "or": [
                  {
                    "in": [
                      "SENT",
                      { "var": "email.labels" }
                    ]
                  },
                  {
                    "==": [
                      { "var": "email.fromDomain" },
                      "inc.nyc"
                    ]
                  }
                ]
              },
              "from": "email.to",
              "excludePattern": "@inc\\.nyc\\b",
              "lookup": true
            },
            {
              "when": {
                "!": {
                  "or": [
                    {
                      "in": [
                        "SENT",
                        { "var": "email.labels" }
                      ]
                    },
                    {
                      "==": [
                        { "var": "email.fromDomain" },
                        "inc.nyc"
                      ]
                    }
                  ]
                }
              },
              "from": "email.from",
              "lookup": true
            }
          ],
          "specTag": [
            {
              "from": "attachmentName",
              "pattern": "(?<=^|[\\s_./-])([A-Za-z]{2}[\\s._-]?\\d{3}[A-Za-z]?)(?=[\\s_./-]|$)",
              "group": 1,
              "normalize": "compactAlnum",
              "lookup": true
            },
            {
              "from": "email.labels",
              "pattern": "(?<=^|[\\s_./-])([A-Za-z]{2}[\\s._-]?\\d{3}[A-Za-z]?)(?=[\\s_./-]|$)",
              "group": 1,
              "normalize": "compactAlnum",
              "lookup": true
            },
            {
              "from": "email.subjectClean",
              "pattern": "(?<=^|[\\s_./-])([A-Za-z]{2}[\\s._-]?\\d{3}[A-Za-z]?)(?=[\\s_./-]|$)",
              "group": 1,
              "normalize": "compactAlnum",
              "lookup": true
            }
          ],
          "revision": [
            {
              "from": "attachmentName",
              "pattern": "(?<=^|[\\s_./-])([A-Za-z]{2}[\\s._-]?\\d{3}[A-Za-z]?)-(\\d{1,2}|[A-Za-z])(?![A-Za-z0-9]|-\\d)",
              "group": 2,
              "normalize": "revision"
            },
            {
              "from": "attachmentName",
              "pattern": "(?<=^|[\\s_./-])([A-Za-z]{2}[\\s._-]?\\d{3}[A-Za-z]?)[\\s_.-]+((?:v|ver\\.?|version)[\\s_.-]*\\d+(?:\\.\\d+)?|(?:rev(?:ision)?\\.?|r(?=[\\s_.]*(?:\\d|[A-Za-z]\\b)))[\\s_.-]*(?:\\d{1,2}[A-Za-z]?|[A-Za-z]\\d{0,2}))(?![A-Za-z0-9]|\\.\\d)",
              "group": 2,
              "normalize": "revision"
            },
            {
              "from": "attachmentName",
              "pattern": "(?:^|[\\s_.-])((?:v|ver\\.?|version)[\\s_.-]*\\d+(?:\\.\\d+)?|(?:rev(?:ision)?\\.?|r(?=[\\s_.]*(?:\\d|[A-Za-z]\\b)))[\\s_.-]*(?:\\d{1,2}[A-Za-z]?|[A-Za-z]\\d{0,2}))(?![A-Za-z0-9]|\\.\\d)",
              "group": 1,
              "normalize": "revision"
            },
            {
              "from": "email.labels",
              "pattern": "(?<=^|[\\s_./-])([A-Za-z]{2}[\\s._-]?\\d{3}[A-Za-z]?)-(\\d{1,2}|[A-Za-z])(?![A-Za-z0-9]|-\\d)",
              "group": 2,
              "normalize": "revision"
            },
            {
              "from": "email.labels",
              "pattern": "(?<=^|[\\s_./-])([A-Za-z]{2}[\\s._-]?\\d{3}[A-Za-z]?)[\\s_.-]+((?:v|ver\\.?|version)[\\s_.-]*\\d+(?:\\.\\d+)?|(?:rev(?:ision)?\\.?|r(?=[\\s_.]*(?:\\d|[A-Za-z]\\b)))[\\s_.-]*(?:\\d{1,2}[A-Za-z]?|[A-Za-z]\\d{0,2}))(?![A-Za-z0-9]|\\.\\d)",
              "group": 2,
              "normalize": "revision"
            },
            {
              "from": "email.subjectClean",
              "pattern": "(?<=^|[\\s_./-])([A-Za-z]{2}[\\s._-]?\\d{3}[A-Za-z]?)-(\\d{1,2}|[A-Za-z])(?![A-Za-z0-9]|-\\d)",
              "group": 2,
              "normalize": "revision"
            },
            {
              "from": "email.subjectClean",
              "pattern": "(?<=^|[\\s_./-])([A-Za-z]{2}[\\s._-]?\\d{3}[A-Za-z]?)[\\s_.-]+((?:v|ver\\.?|version)[\\s_.-]*\\d+(?:\\.\\d+)?|(?:rev(?:ision)?\\.?|r(?=[\\s_.]*(?:\\d|[A-Za-z]\\b)))[\\s_.-]*(?:\\d{1,2}[A-Za-z]?|[A-Za-z]\\d{0,2}))(?![A-Za-z0-9]|\\.\\d)",
              "group": 2,
              "normalize": "revision"
            }
          ],
          "vendor": [
            {
              "from": "attachmentName",
              "normalize": "cleanFilenameText",
              "lookup": true
            },
            {
              "from": "email.labels",
              "lookup": true
            },
            {
              "from": "email.subjectClean",
              "lookup": true
            },
            {
              "when": {
                "!=": [
                  { "var": "email.fromDomain" },
                  "inc.nyc"
                ]
              },
              "from": "email.from",
              "lookup": true
            }
          ]
        }
      },
      {
        "source": "form"
      },
      {
        "source": "drive",
        "fields": {
          "specTag": {
            "from": "drive.fileNameStem",
            "pattern": "(?<=^|[\\s_./-])([A-Za-z]{2}[\\s._-]?\\d{3}[A-Za-z]?)(?=[\\s_./-]|$)",
            "group": 1,
            "normalize": "compactAlnum",
            "lookup": true
          },
          "revision": [
            {
              "from": "drive.fileNameStem",
              "pattern": "(?<=^|[\\s_./-])([A-Za-z]{2}[\\s._-]?\\d{3}[A-Za-z]?)-(\\d{1,2}|[A-Za-z])(?![A-Za-z0-9]|-\\d)",
              "group": 2,
              "normalize": "revision"
            },
            {
              "from": "drive.fileNameStem",
              "pattern": "(?<=^|[\\s_./-])([A-Za-z]{2}[\\s._-]?\\d{3}[A-Za-z]?)[\\s_.-]+((?:v|ver\\.?|version)[\\s_.-]*\\d+(?:\\.\\d+)?|(?:rev(?:ision)?\\.?|r(?=[\\s_.]*(?:\\d|[A-Za-z]\\b)))[\\s_.-]*(?:\\d{1,2}[A-Za-z]?|[A-Za-z]\\d{0,2}))(?![A-Za-z0-9]|\\.\\d)",
              "group": 2,
              "normalize": "revision"
            },
            {
              "from": "drive.fileNameStem",
              "pattern": "(?:^|[\\s_.-])((?:v|ver\\.?|version)[\\s_.-]*\\d+(?:\\.\\d+)?|(?:rev(?:ision)?\\.?|r(?=[\\s_.]*(?:\\d|[A-Za-z]\\b)))[\\s_.-]*(?:\\d{1,2}[A-Za-z]?|[A-Za-z]\\d{0,2}))(?![A-Za-z0-9]|\\.\\d)",
              "group": 1,
              "normalize": "revision"
            }
          ],
          "vendor": {
            "from": "drive.fileNameStem",
            "normalize": "cleanFilenameText",
            "lookup": true
          },
          "date": [
            {
              "from": "drive.fileNameStem",
              "normalize": "yymmdd"
            },
            {
              "from": "drive.modifiedTime"
            },
            {
              "from": "drive.createdTime"
            }
          ]
        }
      }
    ]
  }
}
