{
  "key": "communication-project",
  "name": "Communication Project",
  "documentSchema": {
    "fields": [
      {
        "key": "contact",
        "name": "Contact",
        "type": "string",
        "description": "Contact folder name",
        "required": true,
        "minLength": 1,
        "pattern": "^.*\\S+.*$",
        "options": {
          "source": "contactFolders",
          "key": "key",
          "name": "name",
          "allowUserInput": true,
          "dynamicConfig": {
            "provider": "google_drive",
            "method": "list_folders",
            "relativePath": "1 Admin/Communication"
          }
        }
      },
      {
        "key": "date",
        "name": "Date",
        "type": "string",
        "description": "Date in yyMMdd format",
        "required": true
      },
      {
        "key": "direction",
        "name": "Direction",
        "type": "string",
        "description": "Communication direction",
        "required": true,
        "defaultValue": "IN",
        "options": {
          "source": "direction",
          "key": "key",
          "name": "name"
        }
      },
      {
        "key": "description",
        "name": "Description",
        "type": "string",
        "description": "Description of communication",
        "required": true
      }
    ],
    "calculatedFields": [
      {
        "name": "commFolderName",
        "key": "commFolderName",
        "template": "{{date}} {{direction.key}} - {{description}}"
      }
    ],
    "identity": {
      "id": "{{contact.key}}-{{date}}-{{direction.key}}-{{description}}",
      "idDocument": "{{contact.key}}-{{date}}-{{direction.key}}-{{description}}",
      "idGroup": "{{contact.name}}"
    },
    "options": {
      "direction": [
        {
          "key": "IN",
          "name": "Incoming"
        },
        {
          "key": "OT",
          "name": "Outgoing"
        }
      ]
    }
  },
  "storageContextConfig": {
    "basePath": "1 Admin/Communication"
  },
  "documentUiSchema": {
    "layout": [
      "contact",
      "date",
      "direction",
      "description"
    ],
    "fields": {
      "contact": {
        "widget": "textInput",
        "label": "Contact"
      },
      "date": {
        "widget": "textInput",
        "label": "Date"
      },
      "direction": {
        "widget": "selectionInput",
        "label": "Direction"
      },
      "description": {
        "widget": "textInput",
        "label": "Description"
      }
    },
    "events": {
      "onSubmit": {
        "catchAllWorkflow": "FileCommProject"
      }
    }
  },
  "documentWorkflowConfig": {
    "workflows": [
      {
        "name": "FileCommProject",
        "activitySequence": [
          {
            "type": "MOVE_FILE",
            "payload": {
              "rootStorageId": "{{Document.space.abstractStorageId}}",
              "parentPath": "{{StorageContext.basePath}}",
              "folderName": "{{Document.data.contact.key}}/{{Document.calculated.commFolderName}}"
            }
          }
        ]
      }
    ]
  },
  "documentParseSchema": {
    "extractors": [
      {
        "source": "gmail",
        "fields": {
          "contact": [
            {
              "when": {
                "or": [
                  {
                    "in": [
                      "SENT",
                      {
                        "var": "email.labels"
                      }
                    ]
                  },
                  {
                    "==": [
                      {
                        "var": "email.fromDomain"
                      },
                      "inc.nyc"
                    ]
                  }
                ]
              },
              "from": "email.to",
              "excludePattern": "@inc\\.nyc\\b",
              "lookup": true
            },
            {
              "when": {
                "!": {
                  "or": [
                    {
                      "in": [
                        "SENT",
                        {
                          "var": "email.labels"
                        }
                      ]
                    },
                    {
                      "==": [
                        {
                          "var": "email.fromDomain"
                        },
                        "inc.nyc"
                      ]
                    }
                  ]
                }
              },
              "from": "email.from",
              "lookup": true
            }
          ],
          "date": {
            "from": "email.date"
          },
          "direction": [
            {
              "when": {
                "or": [
                  {
                    "in": [
                      "SENT",
                      {
                        "var": "email.labels"
                      }
                    ]
                  },
                  {
                    "==": [
                      {
                        "var": "email.fromDomain"
                      },
                      "inc.nyc"
                    ]
                  }
                ]
              },
              "set": "OT"
            },
            {
              "set": "IN"
            }
          ],
          "description": {
            "from": "email.subjectClean"
          }
        }
      },
      {
        "source": "drive",
        "fields": {
          "date": [
            {
              "from": "drive.fileNameStem",
              "normalize": "yymmdd"
            },
            {
              "from": "drive.modifiedTime"
            },
            {
              "from": "drive.createdTime"
            }
          ]
        }
      }
    ]
  },
  "allowEmptySourceFiles": true
}