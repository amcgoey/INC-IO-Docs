{
  "key": "submittal-arch",
  "name": "Submittal Arch",
  "documentSchema": {
    "fields": [
      {
        "key": "status",
        "name": "Status",
        "type": "string",
        "required": true,
        "defaultValue": "Open",
        "options": {
          "source": "statuses",
          "key": "key"
        }
      },
      {
        "key": "section",
        "name": "Section",
        "type": "string",
        "description": "6-digit CSI MasterFormat section number (e.g. 071200)",
        "required": true,
        "pattern": "^\\d{6}$"
      },
      {
        "key": "number",
        "name": "Number",
        "type": "string",
        "description": "Submittal sequence number (3+ digits, zero-padded to 3 digits, e.g. 001)",
        "required": true,
        "pattern": "^\\d{3,}$"
      },
      {
        "key": "revision",
        "name": "Revision",
        "type": "string",
        "required": true,
        "minLength": 1,
        "pattern": "^.*\\S+.*$"
      },
      {
        "key": "title",
        "name": "Title",
        "type": "string",
        "required": true,
        "minLength": 1,
        "pattern": "^.*\\S+.*$"
      },
      {
        "key": "date",
        "name": "Date",
        "type": "string",
        "description": "Date in yyMMdd format",
        "required": true
      },
      {
        "key": "contact",
        "name": "Contact",
        "type": "string",
        "required": true,
        "minLength": 1,
        "pattern": "^.*\\S+.*$",
        "options": {
          "source": "contacts",
          "key": "key",
          "name": "name",
          "allowUserInput": true
        }
      },
      {
        "key": "action",
        "name": "Action",
        "type": "string",
        "required": true,
        "defaultValue": "REC",
        "options": {
          "source": "actions",
          "key": "key",
          "name": "name"
        }
      },
      {
        "key": "notes",
        "name": "Notes",
        "type": "string",
        "required": false
      }
    ],
    "optionSources": {
      "statuses": {
        "provider": "document_log",
        "properties": ["key"]
      },
      "actions": {
        "provider": "document_log",
        "properties": ["key", "name", "suffix", "order"]
      },
      "contacts": {
        "provider": "document_log",
        "properties": ["key", "name"]
      },
      "csiDivisions": {
        "provider": "document_log",
        "properties": ["key", "folder"]
      }
    },
    "calculatedFields": [
      {
        "name": "Link",
        "key": "link",
        "template": "-"
      },
      {
        "name": "File Name",
        "key": "fileName",
        "template": "{{section}}-{{number}}-{{revision}} {{title}} - {{date}} {{contact.key}}{{action.suffix}}"
      },
      {
        "name": "Name",
        "key": "name",
        "template": "{{section}}-{{number}}-{{revision}} {{title}}"
      },
      {
        "name": "Number",
        "key": "number",
        "template": "{{section}}-{{number}}-{{revision}}"
      },
      {
        "name": "Contact Chain",
        "key": "contactChain",
        "template": "{{contact.key}}"
      },
      {
        "name": "CSI Division Folder",
        "key": "csiDivisionFolder",
        "template": "{{section}}",
        "transforms": [
          { "type": "prefix", "length": 2 }
        ],
        "lookup": {
          "source": "csiDivisions",
          "matchProperty": "key",
          "resultProperty": "folder"
        },
        "required": true
      }
    ],
    "identity": {
      "idGroup": "{{section}}-{{number}}",
      "idDocument": "{{section}}-{{number}}-{{revision}}",
      "id": "{{section}}-{{number}}-{{revision}}-{{date}}-{{action.order}}"
    }
  },
  "storageContextConfig": {
    "basePath": "6 Construction"
  },
  "documentUiSchema": {
    "layout": [
      "status",
      "section",
      "number",
      "revision",
      "title",
      "date",
      "contact",
      "action",
      "notes"
    ],
    "fields": {
      "status": {
        "widget": "selectionInput",
        "label": "Status"
      },
      "section": {
        "widget": "textInput",
        "label": "Section",
        "onChange": true
      },
      "number": {
        "widget": "textInput",
        "label": "Number",
        "onChange": true
      },
      "revision": {
        "widget": "textInput",
        "label": "Revision"
      },
      "title": {
        "widget": "textInput",
        "label": "Title"
      },
      "date": {
        "widget": "textInput",
        "label": "Date"
      },
      "contact": {
        "widget": "textInput",
        "label": "Contact"
      },
      "action": {
        "widget": "selectionInput",
        "label": "Action"
      },
      "notes": {
        "widget": "textInput",
        "label": "Notes"
      }
    },
    "events": {
      "onSubmit": {
        "catchAllWorkflow": "FileSubmittalArch"
      }
    }
  },
  "documentWorkflowConfig": {
    "workflows": [
      {
        "name": "FileSubmittalArch",
        "activitySequence": [
          {
            "type": "MOVE_FILE",
            "payload": {
              "rootStorageId": "{{Document.space.abstractStorageId}}",
              "parentPath": "{{StorageContext.basePath}}",
              "folderName": "Submittals"
            }
          },
          {
            "type": "WRITE_LOG",
            "payload": {}
          }
        ]
      }
    ]
  },
  "documentLogSchema": {
    "provider": "google_sheets",
    "target": {
      "sheetName": "Submittal Arch",
      "rangeName": "Log_Submittal_Arch",
      "extentMarker": "<--->",
      "groupDividerMarker": "---"
    },
    "grouping": {
      "groupBy": "idGroup",
      "sortBy": "id",
      "groupSortOrder": "asc",
      "rowSortOrder": "asc",
      "duplicatePolicy": "insert"
    },
    "columns": {
      "Status": { "template": "{{status.key}}" },
      "Section": { "template": "{{section}}" },
      "Number": { "template": "{{number}}" },
      "Revision": { "template": "{{revision}}" },
      "Title": { "template": "{{title}}" },
      "Date": { "template": "{{date}}" },
      "Contact": { "template": "{{contact.key}}" },
      "Action": { "template": "{{action.name}}" },
      "Notes": { "template": "{{notes}}" },
      "Calc Link": { "source": "fileLink", "label": "Link" }
    },
    "historyDisplay": {
      "topLabel": "Rev {{revision}} • {{section}}-{{number}} • {{status.key}}",
      "text": "<b>{{action.name}}</b> {{date}} ({{contact.key}})",
      "bottomLabel": "{{title}}"
    },
    "optionBindings": {
      "statuses": {
        "sheetName": "_Config Submittal Arch",
        "rangeName": "Options_Submittal_Arch_Statuses",
        "validationRangeName": "Validation_Submittal_Arch_Statuses",
        "endMarker": "---",
        "columns": {
          "Status": "key"
        }
      },
      "actions": {
        "sheetName": "_Config Submittal Arch",
        "rangeName": "Options_Submittal_Arch_Actions",
        "endMarker": "---",
        "columns": {
          "Action": "key",
          "Name": "name",
          "Suffix": "suffix",
          "Order": "order"
        }
      },
      "contacts": {
        "sheetName": "_Config Submittal Arch",
        "rangeName": "Options_Submittal_Arch_Contacts",
        "validationRangeName": "Validation_Submittal_Arch_Contacts",
        "endMarker": "---",
        "columns": {
          "Contact": "key",
          "Name": "name"
        },
        "aliasesColumn": "Aliases"
      },
      "csiDivisions": {
        "sheetName": "_Config Submittal Arch",
        "rangeName": "Options_Submittal_Arch_CSI_Divisions",
        "endMarker": "---",
        "columns": {
          "Division Number": "key",
          "Division Folder": "folder"
        }
      }
    }
  },
  "documentFormSchema": {
    "fields": {
      "Submittal No": {
        "template": "{{section}}-{{number}}-{{revision}}"
      },
      "Submittal Response": {
        "template": "{{action.name}}",
        "valueMap": {
          "RR": "Revise and Resubmit"
        }
      },
      "Date": {
        "template": "{{date}}",
        "format": "date"
      }
    }
  },
  "documentParseSchema": {
    "extractors": [
      {
        "source": "gmail",
        "fields": {
          "action": [
            {
              "when": {
                "!=": [
                  { "var": "email.fromDomain" },
                  "inc.nyc"
                ]
              },
              "set": "REC"
            }
          ],
          "date": {
            "from": "email.date"
          },
          "contact": [
            {
              "when": {
                "or": [
                  {
                    "in": [
                      "SENT",
                      { "var": "email.labels" }
                    ]
                  },
                  {
                    "==": [
                      { "var": "email.fromDomain" },
                      "inc.nyc"
                    ]
                  }
                ]
              },
              "from": "email.to",
              "excludePattern": "@inc\\.nyc\\b",
              "lookup": true
            },
            {
              "when": {
                "!": {
                  "or": [
                    {
                      "in": [
                        "SENT",
                        { "var": "email.labels" }
                      ]
                    },
                    {
                      "==": [
                        { "var": "email.fromDomain" },
                        "inc.nyc"
                      ]
                    }
                  ]
                }
              },
              "from": "email.from",
              "lookup": true
            }
          ],
          "section": [
            {
              "from": "attachmentName",
              "pattern": "(?:^|[\\s_./-])(\\d{6}|\\d{2} \\d{2} \\d{2}|\\d{2}\\.\\d{2}\\.\\d{2}|\\d{2}-\\d{2}-\\d{2}|\\d{2}_\\d{2}_\\d{2})(?:[\\s_.-]*(?:submittal|sub\\.?|no\\.?)[\\s_.-]*#?[\\s_.-]*|[\\s_.-]*#[\\s_.-]*|[\\s_.-]+)(\\d{1,3})(?![A-Za-z0-9])(?!-\\d{2}[-_.]\\d{2,4})",
              "group": 1,
              "normalize": "digits6"
            },
            {
              "from": "email.labels",
              "pattern": "(?:^|[\\s_./-])(\\d{6}|\\d{2} \\d{2} \\d{2}|\\d{2}\\.\\d{2}\\.\\d{2}|\\d{2}-\\d{2}-\\d{2}|\\d{2}_\\d{2}_\\d{2})(?:[\\s_.-]*(?:submittal|sub\\.?|no\\.?)[\\s_.-]*#?[\\s_.-]*|[\\s_.-]*#[\\s_.-]*|[\\s_.-]+)(\\d{1,3})(?![A-Za-z0-9])(?!-\\d{2}[-_.]\\d{2,4})",
              "group": 1,
              "normalize": "digits6"
            },
            {
              "from": "email.subjectClean",
              "pattern": "(?:^|[\\s_./-])(\\d{6}|\\d{2} \\d{2} \\d{2}|\\d{2}\\.\\d{2}\\.\\d{2}|\\d{2}-\\d{2}-\\d{2}|\\d{2}_\\d{2}_\\d{2})(?:[\\s_.-]*(?:submittal|sub\\.?|no\\.?)[\\s_.-]*#?[\\s_.-]*|[\\s_.-]*#[\\s_.-]*|[\\s_.-]+)(\\d{1,3})(?![A-Za-z0-9])(?!-\\d{2}[-_.]\\d{2,4})",
              "group": 1,
              "normalize": "digits6"
            }
          ],
          "number": [
            {
              "from": "attachmentName",
              "pattern": "(?:^|[\\s_./-])(\\d{6}|\\d{2} \\d{2} \\d{2}|\\d{2}\\.\\d{2}\\.\\d{2}|\\d{2}-\\d{2}-\\d{2}|\\d{2}_\\d{2}_\\d{2})(?:[\\s_.-]*(?:submittal|sub\\.?|no\\.?)[\\s_.-]*#?[\\s_.-]*|[\\s_.-]*#[\\s_.-]*|[\\s_.-]+)(\\d{1,3})(?![A-Za-z0-9])(?!-\\d{2}[-_.]\\d{2,4})",
              "group": 2,
              "normalize": "pad3"
            },
            {
              "from": "email.labels",
              "pattern": "(?:^|[\\s_./-])(\\d{6}|\\d{2} \\d{2} \\d{2}|\\d{2}\\.\\d{2}\\.\\d{2}|\\d{2}-\\d{2}-\\d{2}|\\d{2}_\\d{2}_\\d{2})(?:[\\s_.-]*(?:submittal|sub\\.?|no\\.?)[\\s_.-]*#?[\\s_.-]*|[\\s_.-]*#[\\s_.-]*|[\\s_.-]+)(\\d{1,3})(?![A-Za-z0-9])(?!-\\d{2}[-_.]\\d{2,4})",
              "group": 2,
              "normalize": "pad3"
            },
            {
              "from": "email.subjectClean",
              "pattern": "(?:^|[\\s_./-])(\\d{6}|\\d{2} \\d{2} \\d{2}|\\d{2}\\.\\d{2}\\.\\d{2}|\\d{2}-\\d{2}-\\d{2}|\\d{2}_\\d{2}_\\d{2})(?:[\\s_.-]*(?:submittal|sub\\.?|no\\.?)[\\s_.-]*#?[\\s_.-]*|[\\s_.-]*#[\\s_.-]*|[\\s_.-]+)(\\d{1,3})(?![A-Za-z0-9])(?!-\\d{2}[-_.]\\d{2,4})",
              "group": 2,
              "normalize": "pad3"
            }
          ],
          "revision": [
            {
              "from": "attachmentName",
              "pattern": "(?:^|[\\s_./-])(\\d{6}|\\d{2} \\d{2} \\d{2}|\\d{2}\\.\\d{2}\\.\\d{2}|\\d{2}-\\d{2}-\\d{2}|\\d{2}_\\d{2}_\\d{2})(?:[\\s_.-]*(?:submittal|sub\\.?|no\\.?)[\\s_.-]*#?[\\s_.-]*|[\\s_.-]*#[\\s_.-]*|[\\s_.-]+)(\\d{1,3})-(\\d{1,2}|[A-Za-z])(?![A-Za-z0-9]|-\\d)",
              "group": 3,
              "normalize": "revision"
            },
            {
              "from": "attachmentName",
              "pattern": "(?:^|[\\s_./-])(\\d{6}|\\d{2} \\d{2} \\d{2}|\\d{2}\\.\\d{2}\\.\\d{2}|\\d{2}-\\d{2}-\\d{2}|\\d{2}_\\d{2}_\\d{2})(?:[\\s_.-]*(?:submittal|sub\\.?|no\\.?)[\\s_.-]*#?[\\s_.-]*|[\\s_.-]*#[\\s_.-]*|[\\s_.-]+)(\\d{1,3})[\\s_.-]+((?:v|ver\\.?|version)[\\s_.-]*\\d+(?:\\.\\d+)?|(?:rev(?:ision)?\\.?|r(?=[\\s_.]*(?:\\d|[A-Za-z]\\b)))[\\s_.-]*(?:\\d{1,2}[A-Za-z]?|[A-Za-z]\\d{0,2}))(?![A-Za-z0-9]|\\.\\d)",
              "group": 3,
              "normalize": "revision"
            },
            {
              "from": "attachmentName",
              "pattern": "(?:^|[\\s_.-])((?:v|ver\\.?|version)[\\s_.-]*\\d+(?:\\.\\d+)?|(?:rev(?:ision)?\\.?|r(?=[\\s_.]*(?:\\d|[A-Za-z]\\b)))[\\s_.-]*(?:\\d{1,2}[A-Za-z]?|[A-Za-z]\\d{0,2}))(?![A-Za-z0-9]|\\.\\d)",
              "group": 1,
              "normalize": "revision"
            },
            {
              "from": "email.labels",
              "pattern": "(?:^|[\\s_./-])(\\d{6}|\\d{2} \\d{2} \\d{2}|\\d{2}\\.\\d{2}\\.\\d{2}|\\d{2}-\\d{2}-\\d{2}|\\d{2}_\\d{2}_\\d{2})(?:[\\s_.-]*(?:submittal|sub\\.?|no\\.?)[\\s_.-]*#?[\\s_.-]*|[\\s_.-]*#[\\s_.-]*|[\\s_.-]+)(\\d{1,3})-(\\d{1,2}|[A-Za-z])(?![A-Za-z0-9]|-\\d)",
              "group": 3,
              "normalize": "revision"
            },
            {
              "from": "email.labels",
              "pattern": "(?:^|[\\s_./-])(\\d{6}|\\d{2} \\d{2} \\d{2}|\\d{2}\\.\\d{2}\\.\\d{2}|\\d{2}-\\d{2}-\\d{2}|\\d{2}_\\d{2}_\\d{2})(?:[\\s_.-]*(?:submittal|sub\\.?|no\\.?)[\\s_.-]*#?[\\s_.-]*|[\\s_.-]*#[\\s_.-]*|[\\s_.-]+)(\\d{1,3})[\\s_.-]+((?:v|ver\\.?|version)[\\s_.-]*\\d+(?:\\.\\d+)?|(?:rev(?:ision)?\\.?|r(?=[\\s_.]*(?:\\d|[A-Za-z]\\b)))[\\s_.-]*(?:\\d{1,2}[A-Za-z]?|[A-Za-z]\\d{0,2}))(?![A-Za-z0-9]|\\.\\d)",
              "group": 3,
              "normalize": "revision"
            },
            {
              "from": "email.subjectClean",
              "pattern": "(?:^|[\\s_./-])(\\d{6}|\\d{2} \\d{2} \\d{2}|\\d{2}\\.\\d{2}\\.\\d{2}|\\d{2}-\\d{2}-\\d{2}|\\d{2}_\\d{2}_\\d{2})(?:[\\s_.-]*(?:submittal|sub\\.?|no\\.?)[\\s_.-]*#?[\\s_.-]*|[\\s_.-]*#[\\s_.-]*|[\\s_.-]+)(\\d{1,3})-(\\d{1,2}|[A-Za-z])(?![A-Za-z0-9]|-\\d)",
              "group": 3,
              "normalize": "revision"
            },
            {
              "from": "email.subjectClean",
              "pattern": "(?:^|[\\s_./-])(\\d{6}|\\d{2} \\d{2} \\d{2}|\\d{2}\\.\\d{2}\\.\\d{2}|\\d{2}-\\d{2}-\\d{2}|\\d{2}_\\d{2}_\\d{2})(?:[\\s_.-]*(?:submittal|sub\\.?|no\\.?)[\\s_.-]*#?[\\s_.-]*|[\\s_.-]*#[\\s_.-]*|[\\s_.-]+)(\\d{1,3})[\\s_.-]+((?:v|ver\\.?|version)[\\s_.-]*\\d+(?:\\.\\d+)?|(?:rev(?:ision)?\\.?|r(?=[\\s_.]*(?:\\d|[A-Za-z]\\b)))[\\s_.-]*(?:\\d{1,2}[A-Za-z]?|[A-Za-z]\\d{0,2}))(?![A-Za-z0-9]|\\.\\d)",
              "group": 3,
              "normalize": "revision"
            }
          ],
          "title": [
            {
              "from": "attachmentName",
              "pattern": "(?:^|[\\s_./-])(\\d{6}|\\d{2} \\d{2} \\d{2}|\\d{2}\\.\\d{2}\\.\\d{2}|\\d{2}-\\d{2}-\\d{2}|\\d{2}_\\d{2}_\\d{2})(?:[\\s_.-]*(?:submittal|sub\\.?|no\\.?)[\\s_.-]*#?[\\s_.-]*|[\\s_.-]*#[\\s_.-]*|[\\s_.-]+)(\\d{1,3})(?![A-Za-z0-9])(?!-\\d{2}[-_.]\\d{2,4})(?:-(?:\\d{1,2}|[A-Za-z])(?![A-Za-z0-9]|-\\d)|[\\s_.-]+(?:(?:v|ver\\.?|version)[\\s_.-]*\\d+(?:\\.0+)?|(?:rev(?:ision)?\\.?|r(?=[\\s_.]*(?:\\d|[A-Za-z]\\b)))[\\s_.-]*(?:\\d{1,2}[A-Za-z]?|[A-Za-z]\\d{0,2}))(?![A-Za-z0-9]|\\.\\d))?(?:[\\s_.-]+(?:\\d{4}[-_.]\\d{2}[-_.]\\d{2}|\\d{2}[-_.]\\d{2}[-_.]\\d{4}|\\d{2}[-_.]\\d{2}[-_.]\\d{2}))?[\\s_.-]+(?:[-–—][\\s_]*)?(.+?)(?:[\\s_.-]+[-–—]?[\\s_]*\\d{6}[\\s_]+[A-Za-z0-9]{1,10}(?:_[A-Za-z0-9]{1,6})?|[\\s_.-]+(?:\\d{4}[-_.]\\d{2}[-_.]\\d{2}|\\d{2}[-_.]\\d{2}[-_.]\\d{4}|\\d{2}[-_.]\\d{2}[-_.]\\d{2}|\\d{6})|[\\s_.-]+(?:(?:v|ver\\.?|version)[\\s_.-]*\\d+(?:\\.0+)?|(?:rev(?:ision)?\\.?|r(?=[\\s_.]*(?:\\d|[A-Za-z]\\b)))[\\s_.-]*(?:\\d{1,2}[A-Za-z]?|[A-Za-z]\\d{0,2}))(?![A-Za-z0-9]|\\.\\d))*(?:\\.(?!inc$|ltd$)[A-Za-z0-9]{1,5})?$",
              "group": 3,
              "normalize": "cleanFilenameText"
            },
            {
              "from": "email.labels",
              "pattern": "(?:^|[\\s_./-])(\\d{6}|\\d{2} \\d{2} \\d{2}|\\d{2}\\.\\d{2}\\.\\d{2}|\\d{2}-\\d{2}-\\d{2}|\\d{2}_\\d{2}_\\d{2})(?:[\\s_.-]*(?:submittal|sub\\.?|no\\.?)[\\s_.-]*#?[\\s_.-]*|[\\s_.-]*#[\\s_.-]*|[\\s_.-]+)(\\d{1,3})(?![A-Za-z0-9])(?!-\\d{2}[-_.]\\d{2,4})(?:-(?:\\d{1,2}|[A-Za-z])(?![A-Za-z0-9]|-\\d)|[\\s_.-]+(?:(?:v|ver\\.?|version)[\\s_.-]*\\d+(?:\\.0+)?|(?:rev(?:ision)?\\.?|r(?=[\\s_.]*(?:\\d|[A-Za-z]\\b)))[\\s_.-]*(?:\\d{1,2}[A-Za-z]?|[A-Za-z]\\d{0,2}))(?![A-Za-z0-9]|\\.\\d))?(?:[\\s_.-]+(?:\\d{4}[-_.]\\d{2}[-_.]\\d{2}|\\d{2}[-_.]\\d{2}[-_.]\\d{4}|\\d{2}[-_.]\\d{2}[-_.]\\d{2}))?[\\s_.-]+(?:[-–—][\\s_]*)?(.+?)(?:[\\s_.-]+[-–—]?[\\s_]*\\d{6}[\\s_]+[A-Za-z0-9]{1,10}(?:_[A-Za-z0-9]{1,6})?|[\\s_.-]+(?:\\d{4}[-_.]\\d{2}[-_.]\\d{2}|\\d{2}[-_.]\\d{2}[-_.]\\d{4}|\\d{2}[-_.]\\d{2}[-_.]\\d{2}|\\d{6})|[\\s_.-]+(?:(?:v|ver\\.?|version)[\\s_.-]*\\d+(?:\\.0+)?|(?:rev(?:ision)?\\.?|r(?=[\\s_.]*(?:\\d|[A-Za-z]\\b)))[\\s_.-]*(?:\\d{1,2}[A-Za-z]?|[A-Za-z]\\d{0,2}))(?![A-Za-z0-9]|\\.\\d))*$",
              "group": 3,
              "normalize": "cleanFilenameText"
            },
