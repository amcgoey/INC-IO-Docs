{
  "documentTypes": [
    "./document-types/communication-project.json"
  ],
  "configuration": {
    "workspace": {
      "appTitle": "INC-IO Docs",
      "actionButtonText": "Move Selected File",
      "defaultDocumentType": "communication-project",
      "defaultEventName": "onSubmit"
    },
    "drive": {
      "defaultFolderName": "!TestMove",
      "maxRetries": 3,
      "initialDelayMs": 1000,
      "backoffFactor": 2
    },
    "sheets": {
      "defaultHeaderRangeName": "Headers",
      "defaultDataRangeName": "Data"
    }
  },
  "DocumentSpaceTypes": [
    {
      "id": "project",
      "displayName": "Project",
      "allowedDocumentTypes": [
        "communication-project"
      ],
      "storageConfig": {
        "provider": "google_drive",
        "fetchMethod": "shared_drives",
        "paginationLimit": 500
      }
    }
  ]
}

