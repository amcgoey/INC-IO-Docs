{
  "documentTypes": [
    "./document-types/communication-project.json",
    "./document-types/communication-proposal.json",
    "./document-types/submittal-arch.json",
    "./document-types/submittal-ffe.json"
  ],
  "configuration": {
    "workspace": {
      "defaultDocumentSpaceType": "projects",
      "defaultDocumentType": "communication-project",
      "timeZone": "America/New_York"
    },
    "drive": {
      "defaultFolderName": "Unfiled",
      "maxRetries": 3,
      "initialDelayMs": 1000,
      "backoffFactor": 2
    },
    "documentLog": {
      "preferredFolderPath": "1 Admin",
      "fileNameContains": "Document Log",
      "excludePrefixes": ["Copy of "],
      "excludeSubstrings": ["Template"],
      "templateSpreadsheetId": "1Ops-suWgiqs-_PbaEvdx1WIdUWdVCctJkjS2rPjB42I",
      "copyNameTemplate": "{{DocumentSpace.name}} Document Log"
    },
    "templates": {
      "submittalCoverSheet": "SUBMITTAL_COVER_SHEET_TEMPLATE_ID"
    },
    "maxInMemoryFileBytes": 209715200
  },
  "DocumentSpaceTypes": [
    {
      "id": "projects",
      "displayName": "Projects",
      "spaceSchema": {
        "allowedDocumentTypes": [
          "communication-project",
          "submittal-arch",
          "submittal-ffe"
        ],
        "defaultDocumentType": "communication-project"
      },
      "storageConfig": {
        "provider": "google_drive",
        "fetchMethod": "shared_drives",
        "paginationLimit": 500
      }
    },
    {
      "id": "proposals",
      "displayName": "Proposals",
      "spaceSchema": {
        "allowedDocumentTypes": [
          "communication-proposal"
        ],
        "defaultDocumentType": "communication-proposal"
      },
      "storageConfig": {
        "provider": "google_drive",
        "fetchMethod": "folders",
        "sharedDriveName": "INC Marketing",
        "parentFolderName": "Opportunities",
        "paginationLimit": 500
      }
    }
  ],
  "aliases": {
    "contacts": "./aliases/contacts.json",
    "vendors": "./aliases/vendors.json"
  }
}
